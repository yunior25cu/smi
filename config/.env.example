# Conexion a SQL Server (motor confirmado en Fase 0: MS SQL Server 2022 Express).
# Ryzen7PC\SQLEXPRESS se probo con autenticacion integrada de Windows: no hacen
# falta usuario/clave. Si en otro entorno hiciera falta SQL Auth, completar
# DB_USER/DB_PASSWORD y el conector debe cambiar Trusted_Connection=yes por
# UID=/PWD=.
DB_SERVER=Ryzen7PC\SQLEXPRESS
DB_DATABASE=MAGIK
DB_TRUSTED_CONNECTION=yes
DB_USER=
DB_PASSWORD=
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Contrasena de proteccion de hoja del Excel. NO hace falta en la practica:
# se verifico en Fase 0 que openpyxl escribe celdas en una hoja protegida sin
# necesitar la contrasena (ver README, seccion "Decisiones de diseno"). Se deja
# la variable disponible por si a futuro hace falta abrir/cerrar la proteccion
# explicitamente.
SHEET_PROTECTION_PASSWORD=
