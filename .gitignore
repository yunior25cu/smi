# Credenciales y config local
.env
config/*.local.*

# Archivos Excel reales (plantillas de produccion y salidas generadas)
*.xls
*.xlsx
!tests/fixtures/*.xlsx

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.coverage

# Salidas de exportacion
output/
*.log

# Artefactos de empaquetado (PyInstaller): se regeneran con
# `pyinstaller build/<algo>.spec`, no se versionan. Solo los .spec (archivos
# directos en build/) quedan versionados, no las subcarpetas de cache que
# genera cada build (build/exportador/, build/exportador_test_mssql/, etc.).
build/*/
dist/
